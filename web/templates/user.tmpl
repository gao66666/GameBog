<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>GameBog - 个人主页</title>
  <link rel="stylesheet" href="/static/styles.css" />
  <style>
    /* 覆盖全局 button 白字：分页为浅底按钮 */
    #userPrev, #userNext {
      padding: 6px 16px;
      font-size: 13px;
      border-radius: 8px;
      border: 1px solid #e8e8ed;
      background: #fff;
      color: #1d1d1f;
      cursor: pointer;
    }
    #userPrev:disabled, #userNext:disabled { opacity: .45; cursor: not-allowed; }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="container row">
      <div class="brand"><a href="/">GameBog</a></div>
      <nav class="nav">
        <a href="/" id="navHome">首页</a>
        <a href="/topics" id="navTopics">话题</a>
        <a href="/game-library" id="navGameLibrary">游戏库</a>
        <a href="/me" id="navMe">个人中心</a>
        <a href="/login" id="navLogin">登录</a>
      </nav>
    </div>
  </header>

  <main class="container" id="userPage" data-user-id="{{ .UserID }}">
    <section class="card">
      <h2 id="userTitle">用户</h2>
      <div class="kv">
        <div class="k">用户ID</div><div class="v" id="userId">-</div>
        <div class="k">用户名</div><div class="v" id="userName">-</div>
        <div class="k">在线状态</div><div class="v" id="userOnline">-</div>
        <div class="k">积分</div><div class="v" id="userPoints">-</div>
      </div>

      <div class="row" style="justify-content:flex-start;gap:10px;flex-wrap:wrap;margin-top:10px">
        <button type="button" id="dmBtn" style="display:none">消息</button>
        <button type="button" id="followUserBtn" style="display:none">关注</button>
        <div class="muted" id="userActionMsg"></div>
      </div>
    </section>

    <section class="card">
      <h2>TA 的文章</h2>
      <div id="userArticles" class="list"></div>
      <div id="userArticlesEmpty" class="muted">加载中...</div>
      <div class="row" style="justify-content:flex-start;gap:10px">
        <button type="button" id="userPrev">上一页</button>
        <button type="button" id="userNext">下一页</button>
        <div class="muted" id="userPageInfo"></div>
      </div>
    </section>
  </main>

  <script src="/static/app.js"></script>
  <script src="/static/user.js"></script>
</body>
</html>
