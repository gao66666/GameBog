<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>GoBlog - 私信</title>
  <link rel="stylesheet" href="/static/styles.css" />
</head>
<body>
  <header class="topbar">
    <div class="container row">
      <div class="brand"><a href="/">GoBlog</a></div>
      <nav class="nav">
        <a href="/" id="navHome">首页</a>
        <a href="/topics" id="navTopics">话题</a>
        <a href="/me" id="navMe">个人中心</a>
        <a href="/login" id="navLogin">登录</a>
      </nav>
    </div>
  </header>

  <main class="container" id="dmPage" data-peer-id="{{ .PeerID }}">
    <section class="card">
      <div class="dm-shell">
        <aside class="dm-sidebar">
          <div class="dm-sidebar-hd">
            <div class="dm-sidebar-title">消息列表</div>
            <div class="muted" id="dmStatus"></div>
          </div>
          <div id="dmPeers" class="dm-peers"></div>
          <div id="dmPeersEmpty" class="muted dm-peers-empty">加载中...</div>
        </aside>

        <section class="dm-chat">
          <header class="dm-chat-hd">
            <div class="dm-chat-title" id="dmChatTitle">消息</div>
          </header>

          <div id="dmMessages" class="dm-messages"></div>
          <div id="dmMessagesEmpty" class="muted dm-messages-empty">请选择左侧消息对象</div>

          <form id="dmForm" class="dm-compose">
            <textarea id="dmInput" rows="3" maxlength="500" placeholder="输入内容..." required></textarea>
            <div class="dm-compose-row">
              <button type="submit" id="dmSendBtn">发送</button>
              <div class="muted" id="dmMsg"></div>
            </div>
          </form>
        </section>
      </div>
    </section>
  </main>

  <script src="/static/app.js"></script>
  <script src="/static/dm.js"></script>
</body>
</html>
