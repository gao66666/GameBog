<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>GoBlog - 个人中心</title>
  <link rel="stylesheet" href="/static/styles.css" />
</head>
<body>
  <header class="topbar">
    <div class="container row">
      <div class="brand"><a href="/">GoBlog</a></div>
      <form id="searchForm" class="searchbar">
        <input type="search" id="searchInput" placeholder="搜索文章或用户" />
        <button type="submit">搜</button>
      </form>
      <nav class="nav">
        <a href="/" id="navHome">首页</a>
        <a href="/me" id="navMe">个人中心</a>
        <a href="/login" id="navLogin">登录</a>
      </nav>
    </div>
  </header>

  <main class="container">
    <section class="card" id="searchSection" style="display:none">
      <h2 class="search-title">搜索结果
        <button type="button" id="searchClose" class="search-close" aria-label="关闭搜索结果">×</button>
      </h2>
      <div id="searchMsg" class="muted" style="margin-top:6px"></div>
      <div id="searchResults" style="margin-top:12px;display:none">
        <div>
          <h3>文章</h3>
          <div id="searchArticles" class="list"></div>
        </div>
        <div style="margin-top:12px">
          <h3>用户</h3>
          <div id="searchUsers" class="list"></div>
        </div>
      </div>
    </section>

    <section class="card">
      <h2>我的信息</h2>
      <div class="kv">
        <div class="k">用户ID</div><div class="v" id="meUserId">-</div>
        <div class="k">用户名</div><div class="v" id="meUserName">-</div>
        <div class="k">通知连接</div><div class="v" id="wsStatus">未连接</div>
      </div>
      <p class="muted">通知通过 WebSocket 实时推送（含离线未读同步）。</p>
      <div style="margin-top:10px">
        <button id="navLogout" type="button">退出登录</button>
      </div>
    </section>

    <section class="card">
      <h2>发表文章</h2>
      <div class="row" style="justify-content:flex-start;gap:10px;flex-wrap:wrap">
        <a href="/editor" class="linklike">打开编辑器</a>
      </div>
      <div id="postMsg" class="muted" style="margin-top:10px"></div>
    </section>

    <section class="card">
      <h2>我的文章</h2>
      <div id="myArticles" class="list"></div>
      <div id="myArticlesEmpty" class="muted">加载中...</div>
      <div class="row" style="justify-content:flex-start;gap:10px">
        <button type="button" id="myPrev">上一页</button>
        <button type="button" id="myNext">下一页</button>
        <div class="muted" id="myPageInfo"></div>
      </div>
    </section>

    <section class="card">
      <h2>
        通知
        <span id="notifDot" class="badge" style="display:none"></span>
      </h2>
      <div id="notifEmpty" class="muted">暂无通知</div>
      <ul id="notifList" class="list" style="display:none"></ul>
    </section>
  </main>

  <script src="/static/app.js"></script>
  <script src="/static/search.js"></script>
  <script src="/static/me.js"></script>
</body>
</html>
