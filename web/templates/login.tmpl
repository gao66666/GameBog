<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>GoBlog - 登录</title>
  <link rel="stylesheet" href="/static/styles.css" />
</head>
<body class="page-login">
  <header class="topbar">
    <div class="container row">
      <div class="brand"><a href="/">GoBlog</a></div>
      <nav class="nav">
        <a href="/">首页</a>
        <a href="/me">个人中心</a>
      </nav>
    </div>
  </header>

  <main class="container">
    <section class="card login-card">
      <h2 id="authTitle">登录</h2>
      <p class="muted" id="authDesc">使用手机号 + 密码登录。</p>

      <div id="loginPane">
        <form id="loginForm" class="form">
          <label>
            <div class="label">手机号</div>
            <input name="tel" type="text" inputmode="tel" required />
          </label>
          <label>
            <div class="label">密码</div>
            <input name="password" type="password" required />
          </label>
          <button type="submit">登录</button>
        </form>

        <div id="loginMsg" class="muted" style="margin-top:12px"></div>

        <p class="muted" style="margin-top:8px;font-size:13px">
          测试账号：tel <strong>123456</strong> ，password <strong>123456</strong>
        </p>

        <p class="muted" style="margin-top:8px;font-size:13px">
          还没有账号？<button type="button" id="toRegister" class="linklike">去注册</button>
        </p>
      </div>

      <div id="registerPane" style="display:none">
        <form id="registerForm" class="form">
          <label>
            <div class="label">账号（用户名）</div>
            <input name="username" type="text" required maxlength="50" />
          </label>
          <label>
            <div class="label">手机号（唯一）</div>
            <input name="tel" type="text" required maxlength="20" />
          </label>
          <label>
            <div class="label">密码</div>
            <input name="password" type="password" required />
          </label>
          <button type="submit">注册并登录</button>
        </form>

        <div id="registerMsg" class="muted" style="margin-top:12px"></div>

        <p class="muted" style="margin-top:8px;font-size:13px">
          已有账号？<button type="button" id="toLogin" class="linklike">去登录</button>
        </p>
      </div>
    </section>
  </main>

  <script src="/static/app.js"></script>
  <script src="/static/login.js"></script>
</body>
</html>
