<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>GoBlog - 编辑文章</title>
  <link rel="stylesheet" href="/static/styles.css" />
  <link rel="stylesheet" href="/static/editor.css" />
  <link rel="stylesheet" href="/static/vendor/hljs-github-dark-dimmed.min.css" />
</head>
<body class="page-editor">
  <header class="topbar">
    <div class="container row">
      <div class="brand"><a href="/">GoBlog</a></div>
      <nav class="nav">
        <a href="/" id="navHome">首页</a>
        <a href="/me" id="navMe">个人中心</a>
        <a href="/login" id="navLogin">登录</a>
      </nav>
    </div>
  </header>

  <main class="container" id="editorPage" data-article-id="{{ .ArticleID }}">
    <section class="card editor-card">
      <div class="editor-header row">
        <h1 class="editor-title" id="editorTitle">编辑文章</h1>
        <div class="muted" id="editorStatus"></div>
      </div>

      <div class="editor-toolbar row">
        <div class="row" style="gap:8px;flex-wrap:wrap;justify-content:flex-start">
          <button type="button" id="newArticleBtn">新建</button>
          <button type="button" id="saveArticleBtn">发表</button>
          <label class="linklike" style="cursor:pointer">
            <span>导入文件 (.md / .txt)</span>
            <input type="file" id="editorImportFile" accept=".md,.txt,text/plain" style="display:none" />
          </label>
        </div>
        <div class="muted" id="editorMsg"></div>
      </div>

      <div class="editor-layout">
        <label>
          <div class="label">标题</div>
          <input type="text" id="editorTitleInput" maxlength="200" placeholder="请输入标题" />
        </label>

        <label>
          <div class="label">标签（空格分割，最多 5 个）</div>
          <input type="text" id="editorTagsInput" maxlength="200" placeholder="例如：Go 后端 缓存 并发" />
        </label>

        <div class="editor-frame">
          <div class="editor-frame-header">
            <div class="label">内容（支持 Markdown）</div>
            <div class="label preview-label">预览</div>
          </div>
          <div class="editor-frame-body">
            <div class="editor-subpane editor-subpane-left">
              <textarea id="editorContentInput" placeholder="在这里编写 Markdown 内容..."></textarea>
            </div>
            <div class="editor-subpane editor-subpane-right">
              <div id="editorPreview" class="editor-preview content"></div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script src="/static/vendor/marked.min.js"></script>
  <script src="/static/vendor/highlight.min.js"></script>
  <script src="/static/app.js"></script>
  <script src="/static/editor.js"></script>
</body>
</html>
