    "search_games_by_name": {
      "label": "按名称搜游戏",
      "group": "public",
      "description": "按关键词模糊搜索游戏库，返回最相关的前 3～5 条（game_id、name、发行商等）。用户给的不一定是准确全名；多条时需自行判断最匹配的一条再调 get_game_detail。",
      "auth": false,
      "arg_keys": ["name"],
      "parameter_guide": [
        "name：用户原话中的游戏名、简称或片段（如「博德之门」「老头环」「BG3」），不必完整准确。",
        "返回 games 列表（通常 3～5 条，含 rank）；选与用户意图最一致的一条，将其 game_id 传给 get_game_detail。",
        "0 条则告知未找到；勿猜 game_id。"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "游戏名称关键词（可模糊、不完整）",
            "x-contract": "non_empty_str"
          },
          "limit": {
            "type": "integer",
            "description": "返回候选条数，3～5，默认 5",
            "x-contract": "search_result_limit"
          }
        },
        "required": ["name"]
      },
      "validators": [
        { "field": "name", "rule": "non_empty_str" },
        { "field": "limit", "rule": "search_result_limit" }
      ],
      "call": {
        "method": "search_games",
        "kwargs": { "q": "{{name}}", "limit": "{{limit}}" },
        "defaults": { "limit": 5 }
      },
      "response_preset": "games_search",
      "error_prefix": "搜索失败",
      "start_template": "正在按名称搜索{{label}}：「{{name}}」",
      "end_ok_template": "{{label}}：找到 {{row_count}} 款",
      "end_fail_template": "{{label}}：未能获取到相关信息"
    },
