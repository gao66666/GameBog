{
  "v": 1,
  "description": "GoBlog Agent 工具注册表：MCP/LangChain 执行、args_summary、Go 展示模板。args_summary 键名与 input_schema 参数名一致。",
  "presentation": {
    "partial_unavailable_hint": "部分信息暂时不可用，将继续为您整理已有结果"
  },
  "global_parameter_rules": [
    "禁止臆造 ID：凡 *_id 只能来自同轮已调用工具的返回字段，原样复制（字符串或整数均可），不得用 1、2、3 或连续小整数代替。",
    "雪花 ID（game_id / article_id / user_id）：约 19 位，仅见于 list_all_games、search_articles、list_latest_articles、get_article_leaderboard、get_user_public_profile 等返回的 id。",
    "topic_id：须来自 list_all_topics 返回的 id（可为较小正整数，仍禁止猜测）。",
    "按名称查游戏/文章：必须先调列表或搜索拿到 id，再调详情类工具；不得跳过列表直接猜 id。",
    "可选分页 page≥1，size 在 1～100；未传则用工具默认值。",
    "Wiki/长期记忆里的游戏百科不等于游戏库记录；站内游戏详情仍以 list_all_games + get_game_detail 为准。",
    "按游戏名查价：search_games_by_name 返回最多 5 条候选（name 可模糊/不完整）；从中选最匹配的一条 game_id，再 get_game_detail 查人民币。",
    "按游戏名查积分：search_points_mall_by_name 同样最多 5 条候选 → 选 product_id → get_points_mall_product。",
    "game_id 与 product_id 不可混用；禁止猜测 1、2、3。"
  ],
  "tools": {
    "search_articles": {
      "label": "文章搜索",
      "group": "public",
      "description": "全文搜索文章。返回 articles[].id（雪花 ID）/title/summary 等；后续 get_article_detail 须用此 id。",
      "auth": false,
      "arg_keys": ["query"],
      "input_schema": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "description": "搜索关键词，非空", "x-contract": "non_empty_str" },
          "page": { "type": "integer", "description": "页码，默认 1", "x-contract": "page" },
          "size": { "type": "integer", "description": "每页条数，默认 10，最大 100", "x-contract": "page_size" }
        },
        "required": ["query"]
      },
      "validators": [
        { "field": "query", "rule": "non_empty_str" },
        { "field": "page", "rule": "page" },
        { "field": "size", "rule": "page_size" }
      ],
      "call": {
        "method": "search",
        "kwargs": { "q": "{{query}}", "page": "{{page}}", "size": "{{size}}" },
        "defaults": { "page": 1, "size": 10 }
      },
      "response_preset": "article_search",
      "error_prefix": "搜索失败",
      "start_template": "正在{{label}}：「{{query}}」",
      "end_ok_template": "{{label}}：找到 {{row_count}} 篇",
      "end_fail_template": "{{label}}：未能获取到相关信息"
    },
    "get_article_detail": {
      "label": "文章详情",
      "group": "public",
      "description": "查看文章详情。返回标题、正文（截断2000字）、作者、浏览量、点赞数、标签。",
      "auth": false,
      "arg_keys": ["article_id"],
      "parameter_guide": [
        "article_id 必须来自 search_articles / list_latest_articles / get_topic_articles 返回的 id，原样复制。",
        "禁止传入 1、2、3 或自编 ID。"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "article_id": {
            "type": "integer",
            "description": "文章雪花 ID（约 19 位）",
            "x-contract": "snowflake_id"
          }
        },
        "required": ["article_id"]
      },
      "validators": [{ "field": "article_id", "rule": "snowflake_id" }],
      "call": { "method": "get_article", "kwargs": { "article_id": "{{article_id}}" } },
      "response_preset": "article_detail",
      "error_prefix": "文章不存在",
      "start_template": "正在查看{{label}}（ID {{article_id}}）",
      "end_ok_template": "{{label}}：已获取",
      "end_fail_template": "{{label}}：未能获取到相关信息"
    },
    "list_latest_articles": {
      "label": "最新文章",
      "group": "public",
      "description": "最新文章列表。返回 articles[].id（雪花 ID）/title/summary 等，供 get_article_detail 使用。",
      "auth": false,
