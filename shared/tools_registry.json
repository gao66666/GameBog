      },
      "validators": [{ "field": "sort_by", "rule": "enum_view_like" }],
      "call": {
        "method": "get_article_leaderboard",
        "kwargs": { "tp": "{{sort_by}}" },
        "defaults": { "sort_by": "view" }
      },
      "response_preset": "article_leaderboard",
      "start_template": "正在查询{{label}}",
      "end_ok_template": "{{label}}：已获取",
      "end_fail_template": "{{label}}：未能获取到相关信息"
    },
