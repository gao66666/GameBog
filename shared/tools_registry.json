          "size": { "type": "integer", "description": "每页条数，默认 6，最大 100", "x-contract": "page_size" }
        }
      },
      "validators": [
        { "field": "page", "rule": "page" },
        { "field": "size", "rule": "page_size" }
      ],
      "call": {
        "method": "list_latest_articles",
        "kwargs": { "page": "{{page}}", "size": "{{size}}" },
        "defaults": { "page": 1, "size": 6 }
      },
      "response_preset": "article_search",
      "start_template": "正在获取{{label}}列表",
      "end_ok_template": "{{label}}：找到 {{row_count}} 篇",
      "end_fail_template": "{{label}}：未能获取到相关信息"
    },
    "get_article_leaderboard": {
      "label": "文章排行榜",
      "group": "public",
      "description": "文章排行榜。返回 articles[].id（雪花 ID）等；sort_by 仅 view 或 like。",
