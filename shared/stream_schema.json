{
  "v": 1,
  "description": "Agent Structured SSE fact 层契约。Agent 编排层 StreamEmitter 发出；Go ChatProxy PresentationTranslator 解析并译为用户事件。",
  "transport": {
    "format": "sse",
    "line": "data: {json}\\n\\n",
    "layer": "fact"
  },
  "envelope": {
    "required": ["v", "kind", "seq", "request_id", "ts", "payload"],
    "fields": {
      "v": { "type": "integer", "const": 1 },
      "kind": { "type": "string", "enum": ["stage", "chunk", "control"] },
      "seq": { "type": "integer", "minimum": 1, "description": "单请求内单调递增" },
      "request_id": { "type": "string" },
      "ts": { "type": "integer", "description": "Unix 毫秒" },
      "phase": {
        "type": "string",
        "description": "kind=stage|chunk 时必填；kind=control 时为 session|done|error"
      },
      "status": {
        "type": "string",
        "enum": ["start", "end", "delta"],
        "description": "编排 stage 通常仅 end；tool_invoke 用 start+end；chunk 用 delta"
      },
      "duration_ms": { "type": "integer", "description": "仅 status=end 时" },
      "payload": { "type": "object" }
    }
  },
  "phases": {
    "session": {
      "kind": "control",
      "emit": "once_at_start",
      "presentation": "optional",
      "payload": {
        "required": ["session_id"],
        "properties": {
          "session_id": { "type": "string" },
          "chat_session_id": { "type": "string" }
        }
      }
    },
    "rewrite": {
      "kind": "stage",
      "status": ["end"],
      "presentation": "none",
      "note": "内部预处理，不译给用户",
      "payload": {
        "properties": {
          "input": {
            "type": "object",
            "properties": { "message": { "type": "string" } }
          },
          "output": {
            "type": "object",
            "properties": { "rewritten": { "type": "string" } }
          }
        }
      }
    },
    "route": {
      "kind": "stage",
      "status": ["end"],
      "presentation": "none",
      "payload": {
        "properties": {
          "input": {
            "type": "object",
            "properties": { "message": { "type": "string" } }
          },
          "output": {
            "type": "object",
            "properties": {
              "servers": { "type": "array", "items": { "type": "string" } },
              "has_token": { "type": "boolean" },
              "tool_hints": { "type": "array", "items": { "type": "string" } },
              "memory_hints": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "tool_retrieve": {
      "kind": "stage",
      "status": ["end"],
      "presentation": "none",
      "note": "route 后按改写句 + 路由 tool_hints 召回组内工具候选，供 analysis_pre 短 catalog",
      "payload": {
        "properties": {
          "input": {
            "type": "object",
            "properties": {
              "query": { "type": "string" },
              "servers": { "type": "array", "items": { "type": "string" } },
              "tool_hints": { "type": "array", "items": { "type": "string" } }
            }
          },
          "output": {
            "type": "object",
            "properties": {
              "tools": { "type": "array", "items": { "type": "string" } },
              "count": { "type": "integer", "minimum": 0 },
              "mode": {
                "type": "string",
                "description": "retrieved | skip_small_pool | fallback_all | disabled"
              }
            }
          }
        }
      }
    },
    "analysis_pre": {
      "kind": "stage",
      "status": ["end"],
      "presentation": "thinking",
      "payload": {
        "properties": {
          "input": {
            "type": "object",
            "properties": { "message": { "type": "string" } }
          },
          "output": {
            "type": "object",
            "required": ["resolution"],
            "properties": {
              "intent": { "type": "string", "maxLength": 500 },
              "resolution": { "type": "string", "enum": ["proceed", "clarify", "cannot"] },
              "clarify_message": { "type": "string" },
              "cannot_reason": { "type": "string" }
            }
          }
        }
      }
    },
    "retrieve": {
      "kind": "stage",
      "status": ["end"],
      "presentation": "phase",
      "presentation_skeleton": "retrieving",
      "payload": {
        "properties": {
          "input": {
            "type": "object",
            "properties": {
              "query": { "type": "string" },
              "memory_hints": { "type": "array", "items": { "type": "string" } }
            }
          },
          "output": {
            "type": "object",
            "properties": {
              "hits": { "type": "integer", "minimum": 0 },
              "memories": {
                "type": "array",
                "description": "召回的长期记忆引用（不含 content）",
                "items": {
                  "type": "object",
                  "required": ["store", "id"],
                  "properties": {
                    "store": { "type": "string", "enum": ["mongo", "qdrant"] },
                    "id": { "type": "string", "description": "Mongo fingerprint 或 Qdrant point_id" },
                    "kind": { "type": "string" },
                    "score": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "plan": {
      "kind": "stage",
      "status": ["end"],
      "presentation": "phase",
      "presentation_skeleton": "planning",
      "payload": {
        "properties": {
          "output": {
            "type": "object",
            "properties": {
              "requires_tools": { "type": "boolean" },
              "step_count": { "type": "integer", "minimum": 0 },
              "steps_summary": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "index": { "type": "integer" },
                    "title": { "type": "string" },
                    "tool": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "output": {
      "kind": "stage",
      "status": ["end"],
      "presentation": "phase",
      "presentation_skeleton": "planning",
      "note": "analyse 判定可结束后撰写并下发用户可见回复",
      "payload": {
        "properties": {
          "output": {
            "type": "object",
            "properties": {
              "reply_preview": { "type": "string", "maxLength": 240 }
            }
          }
        }
      }
    },
    "tool_invoke": {
      "kind": "stage",
      "status": ["start", "end"],
      "presentation": "tool_start_on_start|tool_end_on_end",
      "registry": "shared/tools_registry.json",
      "payload": {
        "required": ["tool_call_id"],
        "properties": {
          "tool_call_id": { "type": "string" },
          "input": {
            "type": "object",
            "required": ["tool"],
            "properties": {
              "tool": { "type": "string", "description": "MCP 工具 id，与 tools_registry.json 键一致" },
              "args_summary": {
                "type": "object",
                "description": "键名与 MCP 参数名一致，由 arg_keys 摘取",
                "additionalProperties": true
              }
            }
          },
          "output": {
            "type": "object",
            "description": "仅 status=end",
            "properties": {
              "ok": { "type": "boolean" },
              "error_code": { "type": "string", "description": "内部/日志，不进用户文案" },
              "row_count": { "type": "integer", "minimum": 0 },
              "preview": { "type": "string", "maxLength": 100 }
            }
          }
        }
      },
      "presentation_rules": {
        "ok_true": "end_ok_template",
        "ok_false": "end_fail_template + partial_unavailable_hint"
      }
    },
    "llm_output": {
      "kind": "chunk",
      "status": ["delta"],
      "presentation": "text_chunk",
      "payload": {
        "required": ["delta"],
        "properties": {
          "delta": { "type": "string" },
          "channel": {
            "type": "string",
            "enum": ["answer", "clarify", "early_exit"],
            "default": "answer"
          }
        }
      }
    },
    "done": {
      "kind": "control",
      "emit": "once_at_end",
      "presentation": "done",
      "payload": {
        "properties": {
          "timings": { "type": "object", "additionalProperties": { "type": "integer" } },
          "planning_cycle_complete": { "type": "boolean" },
          "early_exit": { "type": "string", "enum": ["clarify", "cannot"] },
          "usage": {
            "type": "object",
            "description": "单轮 LLM token 消耗汇总",
            "properties": {
              "input_tokens": { "type": "integer" },
              "output_tokens": { "type": "integer" },
              "total_tokens": { "type": "integer" },
              "by_phase": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "input_tokens": { "type": "integer" },
                    "output_tokens": { "type": "integer" },
                    "total_tokens": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "error": {
      "kind": "control",
      "presentation": "error",
      "payload": {
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string", "description": "用户可读短句，无 traceback" },
          "retryable": { "type": "boolean" }
        }
      }
    }
  },
  "presentation_events": {
    "description": "Go BFF 写给前端的 SSE（与 fact 分离）",
    "types": {
      "thinking": {
        "fields": { "type": "thinking", "content": "string" }
      },
      "phase": {
        "fields": {
          "type": "phase",
          "skeleton": "understanding|retrieving|planning|writing",
          "content": "string?"
        }
      },
      "tool_start": {
        "fields": { "type": "tool_start", "content": "string", "meta": { "tool_call_id": "string" } }
      },
      "tool_end": {
        "fields": {
          "type": "tool_end",
          "content": "string",
          "meta": { "tool_call_id": "string", "ok": "boolean", "partial": "boolean?" }
        }
      },
      "text_chunk": {
        "fields": { "type": "text_chunk", "content": "string" }
      },
      "done": {
        "fields": { "type": "done", "meta": "object?" }
      },
      "error": {
        "fields": { "type": "error", "content": "string" }
      }
    }
  },
  "examples": {
    "tool_invoke_start": {
      "v": 1,
      "kind": "stage",
      "seq": 8,
      "request_id": "req_abc",
      "ts": 1716547200123,
      "phase": "tool_invoke",
      "status": "start",
      "payload": {
        "tool_call_id": "tc_1",
        "input": {
          "tool": "search_articles",
          "args_summary": { "query": "复活道具" }
        }
      }
    },
    "tool_invoke_end_fail": {
      "v": 1,
      "kind": "stage",
      "seq": 9,
      "request_id": "req_abc",
      "ts": 1716547200500,
      "phase": "tool_invoke",
      "status": "end",
      "duration_ms": 380,
      "payload": {
        "tool_call_id": "tc_1",
        "input": {
          "tool": "search_articles",
          "args_summary": { "query": "复活道具" }
        },
        "output": {
          "ok": false,
          "error_code": "upstream_error",
          "preview": ""
        }
      }
    },
    "llm_output_delta": {
      "v": 1,
      "kind": "chunk",
      "seq": 10,
      "request_id": "req_abc",
      "ts": 1716547200600,
      "phase": "llm_output",
      "status": "delta",
      "payload": {
        "delta": "为您找到以下文章：",
        "channel": "answer"
      }
    }
  }
}
